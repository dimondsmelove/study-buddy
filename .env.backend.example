# Runtime only. Copy to .env.backend (ignored); never use Vite client variables for secrets.
OPENROUTER_API_KEY=
# Generate: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
SESSION_HMAC_SECRET=
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/study-buddy.sqlite
# Replace with the exact ID shown for this unpacked/store extension.
ALLOWED_ORIGINS=chrome-extension://replace-with-extension-id
# Leave blank for direct connections; list only actual reverse-proxy peer addresses.
TRUSTED_PROXY_IPS=

define protected_v4 = {
  0.0.0.0/8,
  10.0.0.0/8,
  100.64.0.0/10,
  127.0.0.0/8,
  169.254.0.0/16,
  172.16.0.0/12,
  192.0.0.0/24,
  192.0.2.0/24,
  192.88.99.0/24,
  192.168.0.0/16,
  198.18.0.0/15,
  198.51.100.0/24,
  203.0.113.0/24,
  224.0.0.0/4,
  240.0.0.0/4,
  255.255.255.255/32
}

define public_dns_v4 = { 1.1.1.1, 1.0.0.1 }

table inet study_buddy_guard {
  comment "Study Buddy host-network guard"

  chain input {
    type filter hook input priority -10; policy accept;

    iifname "study-buddy0" meta nfproto ipv6 counter drop
    iifname "study-buddy0" ct state invalid counter drop
    iifname "study-buddy0" ct state { established, related } ct direction reply counter accept
    iifname "study-buddy0" counter drop
  }

  chain forward {
    type filter hook forward priority -10; policy accept;

    iifname "study-buddy0" meta nfproto ipv6 counter drop
    iifname "study-buddy0" ct state invalid counter drop
    iifname "study-buddy0" ct state { established, related } ct direction reply counter accept
    iifname "study-buddy0" ip daddr $protected_v4 counter drop
    iifname "study-buddy0" ip daddr $public_dns_v4 udp dport 53 counter accept
    iifname "study-buddy0" ip daddr $public_dns_v4 tcp dport 53 counter accept
    iifname "study-buddy0" tcp dport 443 counter accept
    iifname "study-buddy0" counter drop
  }
}

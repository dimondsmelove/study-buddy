[Unit]
Description=Study Buddy backend with host-network guard
Requires=docker.service
After=docker.service network-online.target
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/study-buddy
Environment=STUDY_BUDDY_ENV_FILE=/home/insert4079/.config/study-buddy/backend.env
Environment=STUDY_BUDDY_IMAGE=study-buddy/backend:release-20261019
ExecStart=/usr/local/libexec/study-buddy-service.sh start
ExecStop=/usr/local/libexec/study-buddy-service.sh stop
TimeoutStartSec=90
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target

{
  "name": "study-buddy",
  "version": "0.1.1",
  "description": "Select any region of the screen and ask an AI about it \u2014 solve, explain, translate. Built on OCR Buddy's battle-tested capture core.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "contracts": "node scripts/contracts.mjs",
    "contracts:storage": "node scripts/storage-contracts.mjs",
    "contracts:prompts": "node scripts/prompt-contracts.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "verify": "node scripts/preview-local.mjs start --headless --smoke",
    "verify:overlay-click": "node scripts/overlay-outside-click-contracts.mjs",
    "playtest": "node scripts/preview-local.mjs",
    "screenshots": "node scripts/preview-local.mjs start --headless --smoke",
    "contracts:context": "node scripts/context-estimator-contracts.mjs",
    "backend:build": "vite build --config vite.backend.config.ts",
    "backend": "npm run backend:build && node .backend-dist/server.js",
    "contracts:backend": "node scripts/backend-contracts.mjs",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.323",
    "@types/node": "^22.20.5",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "marked": "^18.0.14"
  },
  "engines": {
    "node": "22.22.2"
  }
}

{
  "name": "study-buddy",
  "version": "0.1.0",
  "description": "Select any region of the screen and ask an AI about it — solve, explain, translate. Built on OCR Buddy's battle-tested capture core.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "playtest": "npm run build && node scripts/playtest.mjs",
    "quality": "npm run build && node scripts/quality.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "compare": "node scripts/compare.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.323",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "marked": "^18.0.14"
  }
}
